PORT=3000

# PostgreSQL 18. En local, el de Docker (docker compose up -d).
# En Vercel, la cadena pooled de Neon (configurada en el panel, nunca en el repositorio).
DATABASE_URL=postgres://wopa:wopa_local@localhost:5433/wopa

# Servidor donde las pruebas crean bases temporales (por defecto, el de Docker).
PRUEBAS_DATABASE_URL=postgres://wopa:wopa_local@localhost:5433/wopa

# Orígenes permitidos para CORS, separados por coma. Vacío = solo el mismo origen.
FRONTEND_URL=

# Configura estos valores de forma privada; no uses credenciales de ejemplo.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
