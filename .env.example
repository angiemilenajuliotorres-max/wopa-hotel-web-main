PORT=3000

# PostgreSQL 18. En local, el de Docker (docker compose up -d).
# En Vercel, la cadena pooled de Neon (configurada en el panel, nunca en el repositorio).
DATABASE_URL=postgres://wopa:wopa_local@localhost:5433/wopa

# Servidor donde las pruebas crean bases temporales (por defecto, el de Docker).
PRUEBAS_DATABASE_URL=postgres://wopa:wopa_local@localhost:5433/wopa

# URL pública de la web nueva (enlaces en correos de invitación y de pago).
URL_PUBLICA=http://localhost:3100

# Secreto que Vercel Cron envía a /api/cron (expirar retenciones y enviar correos).
CRON_SECRET=

# Correo del equipo que recibe los avisos de tickets nuevos.
CORREO_SOPORTE=soporte@wopa.travel

# Orígenes permitidos para CORS, separados por coma. Vacío = solo el mismo origen.
FRONTEND_URL=

# Cifrado de secretos TOTP: 32 bytes en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETO_CIFRADO=

# Configura estos valores de forma privada; no uses credenciales de ejemplo.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Pasarela simulada (solo desarrollo; nunca en producción).
PAGOS_SIMULADOS=
PAGOS_SIMULADOS_SECRETO=

# Yappy Comercial (activar solo tras verificar en UAT: YAPPY_VERIFICADO=1).
YAPPY_MERCHANT_ID=
YAPPY_CLAVE_SECRETA=
YAPPY_URL_API=
YAPPY_DOMINIO=
YAPPY_VERIFICADO=

# PagueloFacil (activar solo tras verificar en sandbox: PAGUELOFACIL_VERIFICADO=1).
PAGUELOFACIL_CCLW=
PAGUELOFACIL_TOKEN=
PAGUELOFACIL_URL=
PAGUELOFACIL_VERIFICADO=

# Correo transaccional.
RESEND_API_KEY=
CORREO_REMITENTE=
